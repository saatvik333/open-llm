{
  "name": "open-llm",
  "private": true,
  "description": "Build, verify, and deploy the Open LLM book: A5 PDF, EPUB 3, standalone HTML edition, and the Cloudflare site.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saatvik333/open-llm.git"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "build": "./scripts/build-digital-release.sh",
    "build:pdf": "node scripts/build.js",
    "build:site": "node scripts/build-site.js",
    "preflight": "python3 scripts/preflight_release.py",
    "deploy:dry-run": "cf deploy --dry-run",
    "deploy": "cf deploy"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.26",
    "playwright": "1.64.1",
    "wrangler": "4.156.0"
